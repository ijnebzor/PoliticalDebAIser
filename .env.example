# =============================================================================
# PoliticalDebAIser — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# All variables have sensible defaults and are optional.

# --- Ollama LLM Configuration ---

# Base URL for the Ollama API (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Model to use for analysis (default: llama3:8b)
# Popular options: llama3:8b, llama3:70b, mistral, mixtral
OLLAMA_MODEL=llama3:8b

# Request timeout in seconds for Ollama calls (default: 120)
OLLAMA_TIMEOUT=120

# Max concurrent Ollama requests (default: 4)
# Set lower on single-GPU systems; set to 8 if you have fast hardware.
OLLAMA_CONCURRENCY=4

# --- Cache & Storage Limits ---

# Max cached articles in memory (LRU eviction, default: 100)
CACHE_SIZE=100

# Max stored analyses in memory (LRU eviction, default: 500)
STORE_SIZE=500

# --- Rate Limiting ---

# Analysis endpoints (/analyze, /analyze-text) are rate-limited to
# 5 requests per minute per IP address. Other endpoints (/health,
# /history, static assets) are not rate-limited.
# Rate limiting is not currently configurable via env vars.

# --- CORS ---

# Allowed origin for CORS (default: http://localhost:3000)
# CORS_ORIGIN=http://localhost:3000

# --- Logging ---

# Tracing filter (default: info)
# Examples: info, debug, political_debaiser=debug,tower_http=info
RUST_LOG=info

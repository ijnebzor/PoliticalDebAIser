# =============================================================================
# PoliticalDebAIser — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# All variables have sensible defaults and are optional.

# --- Ollama LLM Configuration ---

# Base URL for the Ollama API (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Model to use for analysis (default: llama3.2)
# Popular options: llama3.2, llama3:8b, llama3:70b, mistral, mixtral
OLLAMA_MODEL=llama3.2

# Request timeout in seconds for LLM calls (default: 120)
# LLM_TIMEOUT takes precedence; OLLAMA_TIMEOUT is a fallback alias
LLM_TIMEOUT=120
# OLLAMA_TIMEOUT=120

# Max concurrent LLM requests (default: 4)
# LLM_CONCURRENCY takes precedence; OLLAMA_CONCURRENCY is a fallback alias
LLM_CONCURRENCY=4
# OLLAMA_CONCURRENCY=4

# --- Multi-Provider LLM Chain ---
# Comma-separated list of providers to try in order (default: ollama)
# Options: ollama, groq, gemini, huggingface
# LLM_PROVIDERS=ollama,groq

# Cloud provider API keys (optional — only needed if using cloud providers)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-70b-versatile
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# HF_API_KEY=
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Cache & Storage Limits ---

# Max cached articles in memory (LRU eviction, default: 100)
CACHE_SIZE=100

# Max stored analyses in memory (LRU eviction, default: 500)
STORE_SIZE=500

# Max cached analysis responses in memory (LRU eviction, default: 200)
RESPONSE_CACHE_SIZE=200

# TTL for response cache entries in seconds (default: 3600 = 1 hour)
CACHE_TTL_SECS=3600

# --- Request Handling ---

# Timeout for analysis requests in seconds (default: 30)
REQUEST_TIMEOUT_SECS=30

# Threshold in characters for article summarization before analysis (default: 4000)
# SUMMARY_THRESHOLD=4000

# --- Rate Limiting ---

# Global rate limit: requests per minute per IP (default: 60)
RATE_LIMIT_RPM=60

# Analysis endpoints (/analyze, /analyze-text) have a stricter limit:
# 5 requests per minute per IP (not configurable via env).

# --- Authentication ---

# Bearer token for protected endpoints (POST /config, DELETE /history/:id)
# If not set, protected endpoints return 403 Forbidden.
# CONFIG_AUTH_TOKEN=

# --- CORS ---

# Allowed origin for CORS (default: http://localhost:3000)
# CORS_ORIGIN=http://localhost:3000

# --- Logging ---

# Tracing filter (default: info)
# Examples: info, debug, political_debaiser=debug,tower_http=info
RUST_LOG=info

# Log format: "json" for structured JSON logs, anything else for human-readable
# LOG_FORMAT=json
